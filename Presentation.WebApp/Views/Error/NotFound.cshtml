@section Styles {
    <link rel="stylesheet" href="~/css/not-found.css" asp-append-version="true" />
}
<div class="not-found-wrapper">
    <img src="~/images/404-error-img.png" alt="404 error">
    <div>
        <h1 class="heading">Oops! Page Not Found</h1>
        <p>The page you are looking for does not exists.</p>
    </div>
    <a class="primary-btn" asp-controller="Home" asp-action="Index">
        Back to Home page
        <partial name="Partials/Icons/_ChevronRight" />
    </a>
</div>