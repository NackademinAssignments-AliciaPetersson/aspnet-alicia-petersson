@section Hero {
    <partial name="Partials/_Hero" />
}
@section Styles {
    <link rel="stylesheet" href="~/css/hero.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/logo-banner.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/about-us.css" asp-append-version="true" />
}
@{
    ViewData["Title"] = "Home";
}
<div class="logo-banner-container">
	<div class="logos-wrapper">
		<img src="~/images/logoBanner/logo_1.png" alt="Brand A" />
		<img src="~/images/logoBanner/logo_2.png" alt="Brand B" />
		<img src="~/images/logoBanner/logo_3.png" alt="Brand C" />
		<img src="~/images/logoBanner/logo_4.png" alt="Brand D" />
		<img src="~/images/logoBanner/logo_5.png" alt="Brand E" />
	</div>
	<span class="banner-slogan">Modern Equipment</span>
</div>

<section class="about-us-section container">
	<img src="~/images/about-us-img.png" alt="Gym members training with hand held weights" />
	<div class="right-column">
		<div class="text-wrapper">
			<h2 class="badge">About Us</h2>
			<h3 class="section-heading">Elevating Fitness Journey with Expert Guidance</h3>
			<p>
				We support every stage of your fitness journey with certified trainers,
				personalized programs proven methods designed to help you train safely,
				build strength.
			</p>
		</div>
		<div class="card">
			<p>
				Our mission is to transform lives by combining expert guidance,
				powerful training programs, and a motivating community that helps
				you grow stronger every day.
			</p>
		</div>
	</div>
</section>