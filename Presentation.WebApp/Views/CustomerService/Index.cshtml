@section Styles {
	<link rel="stylesheet" href="~/css/contact-us.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/faq.css" asp-append-version="true" />
}
@{
	var pageTitle = "Customer Service";
	ViewData["Title"] = pageTitle;
}
<h1 class="section-heading page-title">@pageTitle</h1>
<partial name="Partials/Sections/_ContactUs" />
<partial name="Partials/Sections/_FAQ" />
@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}