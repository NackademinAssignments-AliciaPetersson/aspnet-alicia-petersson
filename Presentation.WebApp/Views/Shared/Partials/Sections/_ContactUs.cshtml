<section class="card section container contact-form-section">
	<div class="left-column">
		<img class="form-image"
			 src="~/images/contact-us-image_1.png"
			 alt="Woman holding a barbell" />
		<div class="floating-transparent-card">
			<div class="contact-icon-wrapper">
				<span class="round-icon">
					<partial name="Partials/Icons/_IconPhone" />
				</span>
				<div>
					<h3 class="contact-title">PhoneNumber</h3>
					<a href="tel:+46841052100">+(46) 8 410 521 00</a>
				</div>
			</div>
			<div class="contact-icon-wrapper">
				<span class="round-icon">
					<partial name="Partials/Icons/_IconEnvelope" />
				</span>
				<div>
					<h3 class="contact-title">Email Address</h3>
					<a href="mailto:info@corefitness.se">info@corefitness.se</a>
				</div>
			</div>
		</div>
	</div>
	<div class="right-column">
		<h2 class="section-sub-heading">Contact Us Today!</h2>
		<p>
			Ready to begin your fitness journey? Contact CoreFitness today and let
			our expert trainers guide you with the right program and support.
		</p>
		<form class="contact-form"
			  id="contactForm"
			  method="post"
			  asp-action="Index"
			  asp-controller="CustomerService"
			  novalidate>
			@Html.AntiForgeryToken()

			<div class="form-group first-name">
				<label class="form-label">First Name *</label>
				<input class="form-input" />
				<span class="text-danger"></span>
			</div>

			<div class="form-group last-name">
				<label class="form-label">Last Name *</label>
				<input class="form-input"
					   placeholder="Enter Last Name" />
				<span class="text-danger"></span>
			</div>

			<div class="form-group email">
				<label class="form-label">Email Address *</label>
				<input class="form-input"
					   placeholder="Enter Email Address" />
				<span class="text-danger"></span>
			</div>

			<div class="form-group phone">
				<label class="form-label">Phone Number</label>
				<input class="form-input"
					   placeholder="Enter Phone Number" />
				<span class="text-danger"></span>
			</div>

			<div class="form-group message">
				<label class="form-label">Message *</label>
				<textarea class="form-input"
						  rows="4"
						  placeholder="Message.."></textarea>
				<span class="text-danger"></span>
			</div>

			<button class="primary-btn submit" type="submit">
				Submit Message
				<partial name="Partials/Icons/_ChevronRight" />
			</button>
		</form>
	</div>
</section>