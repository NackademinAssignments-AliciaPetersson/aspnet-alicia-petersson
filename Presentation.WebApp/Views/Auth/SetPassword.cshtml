@model SetPasswordForm
@{
	ViewData["Title"] = "Set Your Password";
	Layout = "Layouts/_AuthLayout";
}
<section class="card auth-card section">
	<div>
		<h1 class="section-heading">@ViewData["Title"]?.ToString()</h1>
		<p>
			Set a strong password to protect your account. For security reasons, your password must be at least 8 characters 
			long and include uppercase and lowercase letters, numbers, and special characters.
		</p>
		<hr class="divider" />
	</div>

	@if(!string.IsNullOrWhiteSpace(ViewData["ErrorMessage"]?.ToString()))
	{
		<div class="error-container">
			<p class="text-danger text-center">@ViewData["ErrorMessage"]?.ToString()</p>
		</div>
	}
	
	<form id="signUpForm" method="post" asp-action="SetPassword" asp-controller="Auth" novalidate>
		@Html.AntiForgeryToken()
		<input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
		<div class="inputs-group">
			<div class="form-group">
				<label class="form-label" asp-for="Email"></label>
				<input readonly class="form-input" asp-for="Email" autocomplete="off" value="@Model.Email"/>
				<span asp-validation-for="Email" class="text-danger"></span>
			</div>
			<div class="form-group">
				<label class="form-label" asp-for="Password"></label>
				<input class="form-input" asp-for="Password" autocomplete="off" />
				<span asp-validation-for="Password" class="text-danger"></span>
			</div>
			<div class="form-group">
				<label class="form-label" asp-for="ConfirmPassword"></label>
				<input class="form-input" asp-for="ConfirmPassword" autocomplete="off" />
				<span asp-validation-for="ConfirmPassword" class="text-danger"></span>
			</div>
		</div>
		<button class="primary-btn" type="submit">
			Continue
			<partial name="Partials/Icons/_ChevronRight" />
		</button>

		<div class="form-group">
			<div class="form-checkbox-group checkbox-center">
				<input class="form-checkbox" asp-for="TermsAndConditions" />
				<label class="form-label" asp-for="TermsAndConditions"></label>
			</div>
			<span asp-validation-for="TermsAndConditions" class="text-danger text-center"></span>
		</div>
		<div asp-validation-summary="ModelOnly"></div>		
	</form>
</section>
