@model string
@{
	var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
	var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
	var currentArea = ViewContext.RouteData.Values["area"]?.ToString();

	bool isLinkActive(string controller, string action, string? area = null)
	{
		return string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
		&& string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase)
		&& (string.IsNullOrEmpty(area) || string.Equals(currentArea, area, StringComparison.OrdinalIgnoreCase));
	}
}
<aside class="profile-aside">
	<img class="profile-img"
		 src="@Model"
		 alt="user profile image" />
	<div class="profile-menu-wrapper">
		<div class="menu-title-wrapper">
			<h2 id="profile-menu-title">Menu Options</h2>
		</div>
		<nav aria-labelledby="profile-menu-title">
			<ul class="profile-menu-links">
				<li class="menu-item">
					<a class="@(isLinkActive("Home", "AboutMe", "Account") ? "active" : "")"
						   asp-area="Account"
						   asp-controller="Home"
						   asp-action="AboutMe">
						About Me
						<partial name="Partials/Icons/_ChevronRight" />
					</a>
				</li>
				<li class="menu-item">
					<a class="@(isLinkActive("Membership", "MyMembership", "Account") ? "active" : "")"
						   asp-area="Account"
						   asp-controller="Membership"
						   asp-action="MyMembership">
						My Membership
						<partial name="Partials/Icons/_ChevronRight" />
					</a>
				</li>
				<li class="menu-item">
					<a class="@(isLinkActive("Bookings", "MyBookings", "Account") ? "active" : "")"
						   asp-area="Account"
						   asp-controller="MyBookings"
						   asp-action="Index">
						My Bookings
						<partial name="Partials/Icons/_ChevronRight" />
					</a>
				</li>
				<li class="menu-item">
					<a asp-area="Account"
						   asp-controller="Home"
						   asp-action="SignOut">
						Sign Out
						<partial name="Partials/Icons/_ChevronRight" />
					</a>
				</li>
			</ul>
		</nav>
	</div>
	<div class="remove-account">
		<p>If you like to cancel your account click below</p>
		<a class="remove-link"
			   asp-area="Account"
			   asp-controller="Home"
			   asp-action="RemoveAccount">
			Remove Account
		</a>
	</div>
</aside>